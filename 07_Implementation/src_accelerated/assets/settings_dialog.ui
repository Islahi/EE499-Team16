   <receiver>stack_settings_pages</receiver>
   <slot>setCurrentIndex(int)</slot>
  </connection>
  <connection>
   <sender>buttons_settings</sender>
   <signal>rejected()</signal>
   <receiver>SettingsDialog</receiver>
